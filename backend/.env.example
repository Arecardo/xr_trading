BACKEND_POSTGRES_DB=xr_trading_core
BACKEND_POSTGRES_USER=postgres
# Local-only placeholder. Replace it in an untracked .env.local file.
BACKEND_POSTGRES_PASSWORD=local-only-database-password
# Different host port than market-info-service's Postgres (5432) so both
# independent database instances can run side by side.
BACKEND_POSTGRES_PORT=5433

# Runtime pool DSN: connects as the low-privilege xr_core_runtime role
# (SELECT/INSERT/UPDATE/DELETE only, no DDL). This is the DSN the three
# CONTRACT-001 repository implementations use -- their Protocol methods
# (AssetRepository.get, etc.) are frozen as *synchronous*, so this DSN uses
# the sync psycopg driver. See repository/database.py module docstring.
BACKEND_DATABASE_URL=postgresql+psycopg://postgres:local-only-database-password@localhost:5433/xr_trading_core?options=-c%20role%3Dxr_core_runtime

# Optional: async (asyncpg) runtime DSN, general-purpose connection pool for
# future async consumers (e.g. FastAPI-native services) that are not bound
# by CONTRACT-001's synchronous Protocol signatures. Not used by the three
# repositories in BE-002; provided so the pool exists ahead of BE-003/BE-004.
BACKEND_ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:local-only-database-password@localhost:5433/xr_trading_core?options=-c%20role%3Dxr_core_runtime

# Migration DSN: connects as the xr_core_owner role (owns the `core` schema,
# may run DDL). Used by Alembic (backend/migrations/env.py).
BACKEND_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:local-only-database-password@localhost:5433/xr_trading_core?options=-c%20role%3Dxr_core_owner

# Only for local/CI integration tests that need an unrestricted connection
# to prepare/inspect fixtures (mirrors MARKET_INFO_TEST_ADMIN_DATABASE_URL).
BACKEND_TEST_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:local-only-database-password@localhost:5433/xr_trading_core

BACKEND_DB_MIN_CONNS=1
BACKEND_DB_MAX_CONNS=8
