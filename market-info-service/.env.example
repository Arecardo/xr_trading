POSTGRES_DB=xr_trading
POSTGRES_USER=postgres
# Local-only placeholder. Replace it in an untracked .env.local file.
POSTGRES_PASSWORD=local-only-database-password
POSTGRES_PORT=5432
MARKET_INFO_DATABASE_URL=postgres://postgres:local-only-database-password@localhost:5432/xr_trading?sslmode=disable&options=-c%20role%3Dxr_market_data_runtime
MARKET_INFO_MIGRATION_DATABASE_URL=postgres://postgres:local-only-database-password@localhost:5432/xr_trading?sslmode=disable&options=-c%20role%3Dxr_market_data_owner
# Only for local/CI integration tests that need to prepare core catalog fixtures.
MARKET_INFO_TEST_ADMIN_DATABASE_URL=postgres://postgres:local-only-database-password@localhost:5432/xr_trading?sslmode=disable
MARKET_INFO_DB_MAX_CONNS=8
MARKET_INFO_DB_MIN_CONNS=1
MARKET_INFO_DB_MAX_CONN_LIFETIME=30m
MARKET_INFO_DB_HEALTH_CHECK_PERIOD=30s
# The existing XR-Trading web application uses 8080 locally.
MARKET_INFO_HTTP_ADDRESS=:8090
MARKET_INFO_PORT=8090
MARKET_INFO_SHUTDOWN_TIMEOUT=10s
# Local-only static management credential. Replace it outside local development.
MARKET_INFO_ADMIN_BEARER_TOKEN=local-only-admin-token
MARKET_INFO_ADMIN_SUBJECT=local-admin
